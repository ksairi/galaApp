{
  "expo": {
    "name": "Gala Dev",
    "description": "Mobile App for Gala Fitness Center",
    "owner": "ksairi",
    "slug": "galaAppEasDev",
    "privacy": "public",
    "version": "1.0",
    "githubUrl": "https://github.com/ksairi/galaApp",
    "primaryColor": "#0b1143",
    "scheme": "galaapp",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "app/assets/**",
      "./assets/*",
      "node_modules/@expo/vector-icons/fonts/FontAwesome.ttf",
      "node_modules/@expo/vector-icons/fonts/Ionicons.ttf",
      "node_modules/@expo/vector-icons/fonts/MaterialIcons.ttf",
      "node_modules/@expo/vector-icons/fonts/Entypo.ttf"
    ],
    "android": {
      "package": "com.gala.galaapp.dev",
      "versionCode": 1,
      "googleServicesFile": "google-services-dev.json",
      "playStoreUrl": "https://play.google.com/",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ],
      "useNextNotificationsApi": true
    },
    "ios": {
      "bundleIdentifier": "com.gala.galaapp.dev",
      "buildNumber": "2",
      "supportsTablet": true,
      "isTabletOnly": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Permite el accesso para poder sacar una foto de perfil",
        "NSMicrophoneUsageDescription": "Permite el acceso para poder usar el micrfono en la app de Zoom",
        "LSApplicationQueriesSchemes": [
          "zoomus"
        ],
        "NSFaceIDUsageDescription":"Gala necesita usar FACE ID / TOUCH ID para autenticarte"
      },
      "associatedDomains": [
        "applinks:y0by.app.link"
      ],
      "usesIcloudStorage": false,
      "config": {
        "branch": {
          "apiKey": "key_live_koQaRLNk7qcj8XnpstDv4goasBbEaAc2"
        }
      },
      "requireFullScreen": true
    },
    "notification": {
      "icon": "./app/assets/icons/notification_icon.png",
      "color": "#000000",
      "androidCollapsedTitle": "Nuevas notificaciones",
      "iosDisplayInForeground": true,
      "androidMode": "collapse"
    },
    "icon": "./assets/app_icon.png",
    "facebookAppId": "361095590638823",
    "facebookDisplayName": "Gala App",
    "facebookAutoInitEnabled": true
  }
}
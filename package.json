{
  "name": "galapp",
  "version": "0.1.8",
  "devDependencies": {
    "@expo/webpack-config": "^0.12.16",
    "@types/react": "~16.9.41",
    "@types/react-native": "~0.62.13",
    "@typescript-eslint/eslint-plugin": "^3.1.0",
    "@typescript-eslint/parser": "^3.1.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-module-resolver": "3.1.1",
    "babel-preset-expo": "^8.2.3",
    "edit-json-file": "^1.4.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-react": "^7.19.0",
    "gh-pages": "^3.1.0",
    "husky": "^4.2.5",
    "jest-expo": "^38.0.0",
    "lint-staged": "^10.2.2",
    "prettier": "^2.0.5",
    "react-test-renderer": "^16.13.1",
    "typescript": "~3.9.5"
  },
  "main": "./node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "adb reverse tcp:3001 tcp:3001 && adb reverse tcp:3000 tcp:3000 && expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "react-devtools": "react-devtools",
    "lint": "eslint './**/*.{js,tsx,ts}' --fix",
    "typecheck": "tsc",
    "nexus5x:android": "emulator -avd Nexus_5X_API_28 &",
    "publish:web:prod": "gh-pages -d web-build -o gala-wpa-prod && node -e 'require(\"./updateExpoAppFile\").init(\"dev\")'",
    "prepublish:web:prod": "node -e 'require(\"./updateExpoAppFile\").init(\"default\")' && expo build:web && echo app.galagym.com > web-build/CNAME",
    "publish:prod": "node -e 'require(\"./updateExpoAppFile\").init(\"default\")' && expo publish && node -e 'require(\"./updateExpoAppFile\").init(\"dev\")'",
    "deploy:ios:prod": "node -e 'require(\"./updateExpoAppFile\").init(\"default\")' && expo build:ios && expo upload:ios && node -e 'require(\"./updateExpoAppFile\").init(\"dev\")'",
    "deploy:android:prod": "node -e 'require(\"./updateExpoAppFile\").init(\"default\")' && expo build:android -t app-bundle && expo upload:android && node -e 'require(\"./updateExpoAppFile\").init(\"dev\")'",
    "publish:web:staging": "gh-pages -d web-build -o gala-wpa-staging",
    "publish:staging": "node -e 'require(\"./updateExpoAppFile\").init(\"staging\")' && expo publish --release-channel staging && node -e 'require(\"./updateExpoAppFile\").init(\"dev\")'",
    "prepublish:web:staging": "node -e 'require(\"./updateExpoAppFile\").init(\"staging\")' && expo build:web && echo testapp.galagym.com > web-build/CNAME",
    "deploy:ios:staging": "node -e 'require(\"./updateExpoAppFile\").init(\"staging\")' && expo build:ios --release-channel staging && expo upload:ios",
    "deploy:android:staging": "node -e 'require(\"./updateExpoAppFile\").init(\"staging\")' && expo build:android -t app-bundle --release-channel staging && expo upload:android",
    "publish:dev": "node -e 'require(\"./updateExpoAppFile\").init(\"dev\")' && expo publish --release-channel dev",
    "deploy:ios:dev": "node -e 'require(\"./updateExpoAppFile\").init(\"dev\")' && expo build:ios --release-channel dev && expo upload:ios",
    "deploy:android:dev": "node -e 'require(\"./updateExpoAppFile\").init(\"dev\")' && expo build:android -t app-bundle --release-channel dev && expo upload:android",
    "publish:all:staging": "yarn publish:staging && yarn publish:web:staging",
    "publish:all:prod": "yarn publish:prod && yarn publish:web:prod"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|@sentry/.*)"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "yarn lint --"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && yarn typecheck"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^10.0.0",
    "@react-native-community/masked-view": "0.1.10",
    "@react-native-community/netinfo": "5.9.2",
    "@react-navigation/drawer": "^5.8.4",
    "@react-navigation/native": "^5.6.1",
    "@react-navigation/stack": "^5.6.2",
    "detect-browser": "^5.1.0",
    "expo": "^38.0.0",
    "expo-analytics": "1.0.11",
    "expo-av": "~8.2.1",
    "expo-camera": "~8.3.1",
    "expo-constants": "~9.1.1",
    "expo-facebook": "~8.2.1",
    "expo-file-system": "~9.0.1",
    "expo-font": "~8.2.1",
    "expo-keep-awake": "~8.2.1",
    "expo-notifications": "~0.3.3",
    "expo-permissions": "~9.0.1",
    "expo-screen-orientation": "~1.1.1",
    "expo-updates": "~0.2.8",
    "moment": "^2.25.2",
    "react": "16.11.0",
    "react-dom": "16.11.0",
    "react-native": "https://github.com/expo/react-native/archive/sdk-38.0.2.tar.gz",
    "react-native-animatable-promise": "1.2.4",
    "react-native-awesome-alerts": "^1.3.2",
    "react-native-dialog": "5.1.0",
    "react-native-gesture-handler": "~1.6.0",
    "react-native-gifted-chat": "0.16.3",
    "react-native-reanimated": "~1.9.0",
    "react-native-safe-area-context": "~3.0.7",
    "react-native-screens": "~2.9.0",
    "react-native-section-list-get-item-layout": "^2.2.3",
    "react-native-timeline-flatlist": "https://github.com/ksairi/react-native-timeline-flatlist#master",
    "react-native-web": "~0.11.7",
    "react-native-web-swiper": "^2.1.1",
    "react-native-web-webview": "^1.0.1",
    "react-native-webview": "9.4.0",
    "react-redux": "5.0.7",
    "redux": "4.0.0",
    "redux-logger": "3.0.6",
    "redux-persist": "5.10.0",
    "redux-thunk": "2.3.0",
    "resize-observer-polyfill": "^1.5.1"
  }
}

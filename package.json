{
  "name": "galapp",
  "version": "0.1.8",
  "devDependencies": {
    "@expo/webpack-config": "^0.12.9",
    "@types/react": "^16.9.35",
    "@types/react-native": "^0.62.13",
    "@typescript-eslint/eslint-plugin": "^3.1.0",
    "@typescript-eslint/parser": "^3.1.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-module-resolver": "3.1.1",
    "babel-preset-expo": "^8.1.0",
    "edit-json-file": "^1.4.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-react": "^7.19.0",
    "husky": "^4.2.5",
    "jest-expo": "^37.0.0",
    "lint-staged": "^10.2.2",
    "prettier": "^2.0.5",
    "react-test-renderer": "^16.13.1"
  },
  "main": "./node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "adb reverse tcp:3001 tcp:3001 && expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "react-devtools": "react-devtools",
    "lint": "eslint './**/*.{js,tsx,ts}' --fix",
    "nexus5:android": "emulator -avd Nexus_5_API_28 &",
    "publish:prod": "rm -rf node_modules && yarn && node -e 'require(\"./updateExpoAppFile\").init(\"default\")' &&  expo publish && node -e 'require(\"./updateExpoAppFile\").init(\"staging\")'",
    "deploy:ios:prod": "rm -rf node_modules && yarn && node -e 'require(\"./updateExpoAppFile\").init(\"default\")' &&  expo build:ios && expo upload:ios && node -e 'require(\"./updateExpoAppFile\").init(\"staging\")'",
    "deploy:android:prod": "rm -rf node_modules && yarn && node -e 'require(\"./updateExpoAppFile\").init(\"default\")' && expo build:android -t app-bundle && expo upload:android && node -e 'require(\"./updateExpoAppFile\").init(\"staging\")'",
    "publish:staging": "rm -rf node_modules && yarn && node -e 'require(\"./updateExpoAppFile\").init(\"staging\")' && expo publish --release-channel staging",
    "deploy:ios:staging": "rm -rf node_modules && yarn && node -e 'require(\"./updateExpoAppFile\").init(\"staging\")' && expo build:ios --release-channel staging && expo upload:ios",
    "deploy:android:staging": "rm -rf node_modules && yarn && node -e 'require(\"./updateExpoAppFile\").init(\"staging\")' && expo build:android -t app-bundle --release-channel staging && expo upload:android",
    "build:web:staging": "node -e 'require(\"./updateExpoAppFile\").init(\"staging\")' && expo build:web && node -e 'require(\"./updateExpoAppFile\").init(\"staging\")'",
    "build:web:prod": "node -e 'require(\"./updateExpoAppFile\").init(\"default\")' && expo build:web && node -e 'require(\"./updateExpoAppFile\").init(\"staging\")'"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|@sentry/.*)"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "yarn lint --"
    ]
  },
  "husky": {
    "hooks": {
        "pre-commit": "lint-staged"
    }
},
  "dependencies": {
    "@expo/vector-icons": "^10.1.0",
    "@react-native-community/netinfo": "5.5.1",
    "detect-browser": "^5.1.0",
    "expo": "^37.0.0",
    "expo-analytics": "1.0.11",
    "expo-av": "~8.1.0",
    "expo-camera": "~8.2.0",
    "expo-constants": "~9.0.0",
    "expo-file-system": "~8.1.0",
    "expo-font": "~8.1.0",
    "expo-keep-awake": "~8.1.0",
    "expo-permissions": "~8.1.0",
    "expo-screen-orientation": "~1.0.0",
    "moment": "^2.25.2",
    "react": "16.9.0",
    "react-dom": "~16.9.0",
    "react-native": "https://github.com/expo/react-native/archive/sdk-37.0.0.tar.gz",
    "react-native-animatable-promise": "1.2.4",
    "react-native-dialog": "5.1.0",
    "react-native-gifted-chat": "0.13.0",
    "react-native-timeline-flatlist": "https://github.com/ksairi/react-native-timeline-flatlist#master",
    "react-native-web": "^0.11.7",
    "react-native-web-swiper": "^2.1.1",
    "react-native-web-webview": "^1.0.1",
    "react-native-webview": "8.1.1",
    "react-navigation": "2.17.0",
    "react-redux": "5.0.7",
    "redux": "4.0.0",
    "redux-logger": "3.0.6",
    "redux-persist": "5.10.0",
    "redux-thunk": "2.3.0",
    "resize-observer-polyfill": "^1.5.1"
  }
}

{
	"name": "galapp",
	"version": "0.1.8",
	"private": true,
	"devDependencies": {
		"babel-eslint": "^6.0.1",
		"babel-plugin-module-resolver": "3.1.1",
		"babel-preset-expo": "^5.0.0",
		"standard": "^7.1.2"
	},
	"main": "./node_modules/expo/AppEntry.js",
	"scripts": {
		"start": "expo start",
		"eject": "expo eject",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"test": "jest",
		"react-devtools": "react-devtools",
		"flow": "flow",
		"lint": "node_modules/standard/bin/cmd.js",
		"lint:fix": "node_modules/standard/bin/cmd.js --fix",
		"deploy:ios": "expo build:ios && expo upload:ios",
		"deploy:android": "expo build:android && expo upload:android"
	},
	"jest": {
		"preset": "jest-expo"
	},
	"standard": {
		"parser": "babel-eslint",
		"globals": [
			"__DEV__",
			"FormData",
			"Expo",
			"fetch"
		]
	},
	"dependencies": {
		"expo": "33.0.0",
		"expo-analytics": "1.0.7",
		"expo-constants": "~5.0.0",
		"react": "16.8.3",
		"react-native": "https://github.com/expo/react-native/archive/sdk-33.0.0.tar.gz",
		"react-native-animatable-promise": "1.2.4",
		"react-native-auto-height-image": "1.0.1",
		"react-native-carousel-control-fork": "https://github.com/ksairi/react-native-carousel-control/archive/v1.0.tar.gz",
		"react-native-dialog": "5.1.0",
		"react-native-gifted-chat": "0.4.3",
		"react-native-image-slider-fork": "https://github.com/ksairi/react-native-image-slider/archive/v1.0.tar.gz",
		"react-native-loading-spinner-overlay": "0.5.2",
		"react-native-timeline-listview": "0.2.3",
		"react-navigation": "2.17.0",
		"react-redux": "5.0.7",
		"redux": "4.0.0",
		"redux-logger": "3.0.6",
		"redux-persist": "5.10.0",
		"redux-thunk": "2.3.0"
	}

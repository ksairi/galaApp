{
  "name": "galapp",
  "version": "0.1.8",
  "devDependencies": {
    "babel-eslint": "^6.0.1",
    "babel-plugin-module-resolver": "3.1.1",
    "babel-preset-expo": "^8.1.0",
    "standard": "^7.1.2"
  },
  "main": "./node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "react-devtools": "react-devtools",
    "lint": "node_modules/standard/bin/cmd.js",
    "lint:fix": "node_modules/standard/bin/cmd.js --fix",
    "nexus5:android": "emulator -avd Nexus_5_API_28 &",
    "publish:prod": "expo publish",
    "deploy:ios": "expo build:ios && expo upload:ios",
    "deploy:android": "expo build:android -t app-bundle && expo upload:android"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "standard": {
    "parser": "babel-eslint",
    "globals": [
      "__DEV__",
      "FormData",
      "fetch"
    ]
  },
  "dependencies": {
    "@react-native-community/netinfo": "5.5.0",
    "expo": "^37.0.0",
    "expo-analytics": "1.0.11",
    "expo-av": "~8.1.0",
    "expo-camera": "~8.2.0",
    "expo-constants": "~9.0.0",
    "expo-file-system": "~8.1.0",
    "expo-font": "~8.1.0",
    "expo-permissions": "~8.1.0",
    "expo-screen-orientation": "~1.0.0",
    "react": "16.9.0",
    "react-native": "https://github.com/expo/react-native/archive/sdk-37.0.0.tar.gz",
    "react-native-animatable-promise": "1.2.4",
    "react-native-auto-height-image": "1.0.1",
    "react-native-carousel-control-fork": "https://github.com/ksairi/react-native-carousel-control/archive/v1.0.tar.gz",
    "react-native-dialog": "5.1.0",
    "react-native-gifted-chat": "0.13.0",
    "react-native-image-slider-fork": "https://github.com/ksairi/react-native-image-slider/archive/v1.0.tar.gz",
    "react-native-loading-spinner-overlay": "0.5.2",
    "react-native-timeline-listview": "ksairi/react-native-timeline-deprecated-listview.git#master",
    "react-native-webview": "8.1.1",
    "react-navigation": "2.17.0",
    "react-redux": "5.0.7",
    "redux": "4.0.0",
    "redux-logger": "3.0.6",
    "redux-persist": "5.10.0",
    "redux-thunk": "2.3.0",
    "with-default-props": "^0.2.1"
  }
}
